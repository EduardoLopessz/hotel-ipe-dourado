# ── Firebase (client) ─────────────────────────────────────────────
# Console do Firebase > Configurações do projeto > Seus apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase (Admin SDK — servidor) ───────────────────────────────
# Console do Firebase > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada. Usado nas Route Handlers/Server Actions
# para transações atômicas de reserva e para o painel administrativo.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Cole a chave privada completa entre aspas, mantendo os \n literais.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Mercado Pago (sandbox/teste) ──────────────────────────────────
# developers.mercadopago.com > Suas integrações > Credenciais de teste.
# NUNCA use credenciais de produção neste projeto fictício.
MERCADOPAGO_ACCESS_TOKEN=

# ── Upstash Redis (rate limiting) ─────────────────────────────────
# console.upstash.com > Redis > Create database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── PostHog (analytics) ───────────────────────────────────────────
# app.posthog.com > Project Settings > Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── App ────────────────────────────────────────────────────────────
# URL pública do site, usada nas back_urls/notification_url do Mercado
# Pago. Em produção na Vercel, use a URL do domínio/deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
