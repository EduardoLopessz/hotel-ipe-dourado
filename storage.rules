rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Fotos de quartos, comodidades etc. — leitura pública, upload restrito
    // a administradores (usadas pelo painel administrativo).
    match /hotel/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avatares/anexos de usuários — cada usuário só acessa sua própria pasta.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
